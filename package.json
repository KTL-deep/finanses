{
  "name": "family-finance-app",
  "version": "1.0.0",
  "description": "Timur & Lera Family Financial Architecture App with React, shadcn & corr UI",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,VITE\" -c \"blue.bold,green.bold\" \"node --watch server.js\" \"vite\"",
    "dev:vite": "vite",
    "dev:server": "node --watch server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "build:apk": "npm run cap:sync && cmd /c \"set JAVA_HOME=C:\\Program Files\\Microsoft\\jdk-21.0.12.8-hotspot& set PATH=C:\\Program Files\\Microsoft\\jdk-21.0.12.8-hotspot\\bin;%PATH%& cd android& gradlew.bat assembleDebug\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@number-flow/react": "^0.5.5",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.1.8",
    "chart.js": "^4.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
